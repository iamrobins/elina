POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_TOKEN=replace-with-a-different-random-token-at-least-32-characters
ATTRIBUTE_DENYLIST=
SESSION_SECRET=replace-with-64-random-hex-characters
DASHBOARD_PASSWORD_HASH=scrypt:replace-with-salt-hex:replace-with-hash-hex

# Only for self-hosting with compose.prod.yaml. Use your own domain, not getelina.com.
# Point BACKUP_DIR at an absolute path on your host.
ELINA_DOMAIN=elina.example.com
ACME_EMAIL=admin@example.com
BACKUP_DIR=/opt/elina/backups
